# ---------------------------------------------------------------------------
# Toolbox Atlas environment variables. Copy to .env and fill in real values.
# NEVER commit .env files. All secrets belong in your host's secret manager.
# ---------------------------------------------------------------------------

# MySQL 5.7+/8 or MariaDB connection. The database must use utf8mb4.
# Local example: Laragon/XAMPP MySQL, user root with no password, database "bloger".
# In production use a least-privilege user with a strong password.
DATABASE_URL="mysql://root@localhost:3306/bloger"

# Public canonical origin, no trailing slash. Used for canonical URLs, sitemaps, hreflang.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Brand name shown when the database setting is not yet configured.
NEXT_PUBLIC_SITE_NAME="Toolbox Atlas"

# Secret used to authorize the scheduled-publishing cron endpoint.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Media storage: "database" (default, durable, fine for small libraries) or "s3".
MEDIA_STORAGE="database"
# Required only when MEDIA_STORAGE="s3" (any S3-compatible provider, e.g. AWS S3, Cloudflare R2).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Hard kill-switch for live advertising. Ads load only when this is "true" AND the
# dashboard configuration enables live mode AND the environment is production.
ADS_ALLOW_LIVE="false"

# Contact form (optional). The form appears on the Contact page only when all three are set.
# EMAIL_USER is a Gmail address; EMAIL_PASS is a Google *app password* for it
# (Google Account → Security → 2-Step Verification → App passwords), never the account password.
# Messages are delivered to RECIPIENT_EMAIL with the visitor in Reply-To.
EMAIL_USER=""
EMAIL_PASS=""
RECIPIENT_EMAIL=""

# --- Desktop app (Tauri) build settings — used by scripts/desktop/prepare.mjs and CI ---
# Official website URL. The desktop app downloads background-removal models from here
# (and falls back to Hugging Face / jsDelivr). Leave empty until the domain is final.
TOOLBOX_SITE_URL=""
# Where installers are downloaded from (Phase 4) and the Tauri updater endpoint (Phase 5).
TOOLBOX_DOWNLOAD_BASE_URL=""
TOOLBOX_UPDATE_ENDPOINT=""
