{
  "name": "toolbox-atlas",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/models/sync-models.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/reset-password.ts",
    "postinstall": "prisma generate",
    "models:sync": "node scripts/models/sync-models.mjs",
    "models:update": "node scripts/models/update-manifest.mjs",
    "fonts:sync": "node scripts/fonts/sync-fonts.mjs",
    "desktop:prepare": "node scripts/desktop/prepare.mjs",
    "desktop:frontend": "node scripts/desktop/prepare.mjs && tsx scripts/desktop/catalog.ts && next build desktop",
    "desktop:frontend:dev": "next dev desktop -p 3010",
    "desktop:dev": "node scripts/desktop/prepare.mjs && tauri dev --config src-tauri/tauri.generated.conf.json",
    "desktop:build": "node scripts/desktop/prepare.mjs && tauri build --config src-tauri/tauri.generated.conf.json",
    "desktop:build:windows": "node scripts/desktop/prepare.mjs && tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.generated.conf.json",
    "desktop:version": "node scripts/desktop/version.mjs",
    "desktop:publish-local": "node scripts/desktop/publish-local.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@huggingface/transformers": "4.3.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
